[node name="Signs" type="Node2D" parent="LevelNodes"]

[node name="MoveSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(24, 0)
text = "Press 'a' and 'd', or <- and ->, to move left and right."

[node name="JumpSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(-72, 0)
text = "Press 'w', or ^, to jump. Try to move and jump up onto those platforms above."

[node name="PlatformSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(24, -48)
text = "Good job. These bricks are solid, but these thinner, wood platforms above us can be jumped through below. However, much like the bricks, you can not jump through them from above."

[node name="DashSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(-72, -336)
text = "Some gaps are too wide to be jump acrossed. Try dashing with 'space', which will propell you forward without regard for gravity. After dashing, there is a cooldown before you may dash again."

[node name="SpikesSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(24, -432)
text = "Spikes hurt. Dashing also lets you avoid damage. Try dashing through the spikes, or maybe try jumping over them."

[node name="AttackSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(-8, -624)
text = "Ok, let's use that big sword of yours. Press 'r' to swing it. Go ahead and swing it at that chest right there. Maybe there's something in there..."

[node name="LieSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(-24, -672)
text = "Ok... I lied. But, maybe next time?"

[node name="ComboSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(40, -672)
text = "Anyways... you can also combo multiple strikes if you quickly attack in sequence. On the third strike, you'll deal added damage and knockback. Watch for the cool sword swings to show different combo strikes!"

[node name="EnemySign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(-56, -720)
text = "Woah, look at that mean lookin fella up there. Try out your combo swords moves to quickly get rid of him. Remember, hit the attack button in quick succesion to combo!"

[node name="HighGroundSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(0, -816)
text = "These sword dudes have a hard time reaching you from below. However, some foes may not have as much trouble..."

[node name="GhostSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(-56, -1024)
text = "Yeesh! That thing was scary, right? Oh, not really? Well... I geuss that's good. Anyways, you're doing great. Keep climbing, you'll find out why soon."

[node name="CampfireSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(8, -864)
text = "Here, why don't you take a rest at this campfire. These will serve as a point of rest in the tower. If you are to fall, you'll wake up at the last campfire you ignited. Go ahead and light this one."

[node name="ManaSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(-32, -1216)
text = "Alright, this chest has something in it for real this time. You'll find a mana bottle you'll use to re-fill your mana, as seen in the top right."

[node name="FireballSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(24, -1264)
text = "Press 'q' to fire a fireball. These bad boys can pack a punch from a distance, but they cost 1 mana per fireball. Fireball that chest!"

[node name="WinSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(-40, -1456)
text = "You made it to the top! Or, well, at least the top of this part. Good stuff. That flag there is the goal, go ahead and claim it like the winner you are."

[node name="FightSign" parent="LevelNodes/Signs" instance=ExtResource("6_dcbm7")]
position = Vector2(-32, -1312)
text = "Alright, good work! Go ahead and rest at this campfire and get ready for one last fight to the top!"

